{
  "pluginAlias": "CG Smarthouse",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "CG Smarthouse",
        "required": true
      },
      "url": {
        "title": "SmartHouse URL",
        "type": "string",
        "format": "uri",
        "required": true,
        "placeholder": "http://192.168.1.100",
        "description": "The base URL of your CG SmartHouse system (e.g., http://192.168.1.100)"
      },
      "username": {
        "title": "Username",
        "type": "string",
        "required": true,
        "description": "Your SmartHouse username"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true,
        "description": "Your SmartHouse password"
      },
      "accessories": {
        "title": "Accessories",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true,
              "description": "The name of the accessory as it will appear in HomeKit"
            },
            "type": {
              "title": "Type",
              "type": "string",
              "required": true,
              "enum": [
                "light",
                "dimmable-light",
                "switch",
                "stateless-switch",
                "temperature-sensor",
                "thermostat"
              ],
              "description": "The type of accessory"
            },
            "paramid": {
              "title": "Parameter ID",
              "type": "integer",
              "required": true,
              "minimum": 1,
              "description": "The parameter ID of the device in the SmartHouse system"
            }
          }
        }
      }
    },
    "required": [
      "name",
      "url",
      "username", 
      "password",
      "accessories"
    ]
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "SmartHouse Connection",
      "expandable": false,
      "items": [
        "name",
        "url",
        "username",
        "password"
      ]
    },
    {
      "key": "accessories",
      "type": "array",
      "title": "Accessories",
      "items": [
        "accessories[].name",
        "accessories[].type",
        "accessories[].paramid"
      ]
    }
  ]
}